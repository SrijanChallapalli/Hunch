# Copy to indexer/.env (gitignored) and adjust as needed.
DATABASE_URL=postgresql://postgres:pmpass@localhost:5433/prediction_market

# JSON-RPC endpoint the indexer polls (local Hardhat node, or a Sepolia provider).
RPC_URL=http://127.0.0.1:8545

# Confirmation depth for durable views (0 for the local latency benchmark).
INDEXER_CONFIRMATIONS=0
INDEXER_REORG_DEPTH=5
